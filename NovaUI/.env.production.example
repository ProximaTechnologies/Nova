# Template only: set real credentials and hostnames through your secret manager.
DJANGO_SETTINGS_MODULE=NovaUI.settings_prod
DEBUG=False
SECRET_KEY=
DATABASE_URL=postgresql://novaui:CHANGE_ME@postgres:5432/novaui
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=ui.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ui.example.com
UI_URL=https://ui.example.com
CONFIGURATION_URL=https://config.example.com
NOVA_PUBLIC_URL=https://ui.example.com
NOVA_OIDC_ISSUER_URL=https://ui.example.com
GRAFANA_PROTOCOL=https
GRAFANA_HOST=grafana.example.com
GRAFANA_EXTERNAL_URL=https://grafana.example.com
GRAFANA_USER=admin
GRAFANA_PASSWORD=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nova <noreply@example.com>
# Configure GitOps, sealing certificate, and ingestion services before enrollment.
GITOPS_REPO_PATH=
GITOPS_SEALED_SECRETS_CERT_FILE=

# Optional manual billing and overdue enforcement (off for self-hosting).
BILLING_ENABLED=false
