# Development only. Copy to .env, then: set -a; . ./.env; set +a
# Django does not load this file automatically. Replace the secret before use.
DJANGO_SETTINGS_MODULE=NovaUI.settings
DEBUG=True
SECRET_KEY=replace-with-a-random-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000
UI_URL=http://localhost:8000
CONFIGURATION_URL=http://localhost:8080
REDIS_URL=redis://127.0.0.1:6379/0
GRAFANA_PROTOCOL=http
GRAFANA_HOST=localhost:3000
GRAFANA_EXTERNAL_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL='Nova <noreply@localhost>'

# Optional manual billing and overdue enforcement (off for self-hosting).
BILLING_ENABLED=false
